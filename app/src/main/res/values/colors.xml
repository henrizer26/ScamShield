<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light (day) palette. The dark counterpart is values-night/colors.xml, so
      flipping AppCompatDelegate's night mode reskins the whole app.
      Keep these names semantic - never encode "light"/"dark" in a name.
    -->

    <!-- Brand -->
    <color name="primary">#0091B2</color>
    <color name="primary_dark">#00728C</color>
    <color name="primary_light">#4FC3E0</color>

    <color name="secondary">#1A73E8</color>
    <color name="secondary_dark">#0D47A1</color>

    <color name="accent">#D94A4A</color>
    <color name="accent_warning">#B26B00</color>
    <color name="accent_success">#2E7D32</color>

    <!-- Surfaces -->
    <color name="bg_app">#F0F4FF</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="glass">#0F000000</color>
    <color name="glass_border">#26000000</color>

    <!-- Text -->
    <color name="text_primary">#1A1A2E</color>
    <color name="text_secondary">#5A6A7A</color>

    <!-- Launcher icon background: fixed, must not follow the in-app theme -->
    <color name="launcher_background">#0A0E1A</color>
</resources>
