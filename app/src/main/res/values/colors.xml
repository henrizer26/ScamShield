<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light (day) palette, taken from the UI reference. The dark counterpart is
      values-night/colors.xml, so flipping AppCompatDelegate's night mode
      reskins the whole app. Keep these names semantic - never encode
      "light"/"dark" in a name.
    -->

    <!-- Brand -->
    <color name="primary">#4B1DD8</color>
    <color name="primary_dark">#35129E</color>
    <color name="primary_light">#EDE8FF</color>
    <color name="primary_soft">#D5CEFB</color>
    <color name="on_primary">#FFFFFF</color>

    <!-- Risk scale -->
    <color name="risk_high">#E53935</color>
    <color name="risk_high_bg">#FFECEA</color>
    <color name="risk_medium">#F59E0B</color>
    <color name="risk_medium_bg">#FFF6E6</color>
    <color name="risk_low">#22A94A</color>
    <color name="risk_low_bg">#E9FAEE</color>

    <!-- Status -->
    <color name="accent">#E53935</color>
    <color name="accent_warning">#F59E0B</color>
    <color name="accent_success">#22A94A</color>
    <color name="success_strong">#34A853</color>
    <color name="info_blue">#4FA8F5</color>

    <!-- Surfaces -->
    <color name="bg_app">#F7F7FC</color>
    <color name="bg_card">#FFFFFF</color>
    <color name="bg_muted">#EFEEF4</color>
    <color name="divider">#ECECF3</color>
    <color name="glass">#FFFFFF</color>
    <color name="glass_border">#ECECF3</color>

    <!-- Result screen (scan verdict) -->
    <color name="result_bg_top">#FFF3F1</color>
    <color name="result_bg_bottom">#FFFFFF</color>
    <color name="result_preview_bg">#FEE6E2</color>

    <!-- Splash -->
    <color name="splash_bg_top">#1B0770</color>
    <color name="splash_bg_bottom">#0B0148</color>
    <color name="splash_protect">#6C63FF</color>
    <color name="splash_detect">#22C55E</color>
    <color name="splash_report">#FF7A45</color>
    <color name="splash_check">#FFAE00</color>
    <color name="splash_track">#3B2F7A</color>

    <!-- Text -->
    <color name="text_primary">#14142B</color>
    <color name="text_secondary">#6B7280</color>
    <color name="text_tertiary">#9AA0AE</color>

    <!-- Launcher icon background: fixed, must not follow the in-app theme -->
    <color name="launcher_background">#0A0E1A</color>
</resources>
