<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/edit_24"
        android:drawablePadding="12dp"
        android:drawableTint="@color/text_primary"
        android:gravity="center_vertical"
        android:text="@string/report_title"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/report_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="16sp"
        android:layout_marginTop="8dp"/>

    <!-- Phone Number -->
    <EditText
        android:id="@+id/etPhone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:hint="@string/hint_phone"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:background="@color/glass"
        android:padding="16dp"/>

    <!-- Message -->
    <EditText
        android:id="@+id/etMessage"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="16dp"
        android:hint="@string/hint_message"
        android:textColorHint="@color/text_secondary"
        android:textColor="@color/text_primary"
        android:background="@color/glass"
        android:padding="16dp"
        android:gravity="top"/>

    <!-- Result: ivResult is set by ReportFragment and hidden while empty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@color/glass"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/ivResult"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:contentDescription="@null"
            android:visibility="gone"
            tools:src="@drawable/warning_24"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/text_primary"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Analyze Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAnalyze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/action_analyze"
        android:textColor="@color/bg_app"
        android:backgroundTint="@color/primary"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/search_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/bg_app"/>

    <!-- Report Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnReport"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:text="@string/action_report"
        android:textColor="@color/text_primary"
        android:backgroundTint="#FF6B6B"
        android:textSize="16sp"
        android:textStyle="bold"
        app:icon="@drawable/report_24"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/text_primary"/>

    <!-- Quick Report Section -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quick_report"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnReportTCRA"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/channel_tcra"
            android:textColor="@color/bg_app"
            android:backgroundTint="@color/accent_warning"
            android:textSize="12sp"/>

        <Button
            android:id="@+id/btnReportNetwork"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/channel_network"
            android:textColor="@color/bg_app"
            android:backgroundTint="@color/primary"
            android:textSize="12sp"/>
    </LinearLayout>

</LinearLayout>